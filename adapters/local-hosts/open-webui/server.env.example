# Consumed by the AutoCache MCP bridge process, not by the model.
AUTOCACHE_HOME=C:\Users\YOUR_USER\.autocache
AUTOCACHE_STORE_SCOPE=open-webui
AUTOCACHE_MCP_ACTOR=open-webui
AUTOCACHE_WORKSPACE=C:\absolute\path\to\your\workspace

# Same-host, non-container default:
AUTOCACHE_MCP_HOST=127.0.0.1
AUTOCACHE_MCP_PORT=3210

# Optional on loopback. Required with at least 16 characters off loopback.
AUTOCACHE_MCP_TOKEN=replace-with-a-long-random-token

# Required off loopback. Use only the names Open WebUI actually sends.
AUTOCACHE_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# Required off loopback. These are browser origins, separate from Host names.
AUTOCACHE_MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
