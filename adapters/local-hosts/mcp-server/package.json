{
  "name": "@autocache/local-host-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only MCP bridge from MCP-capable local model hosts to AutoCache continuity state.",
  "type": "module",
  "bin": {
    "autocache-local-mcp": "src/cli.js"
  },
  "scripts": {
    "start:stdio": "node src/cli.js stdio",
    "start:http": "node src/cli.js http",
    "test": "node --test --test-reporter spec",
    "test:stdio": "node --test --test-reporter spec test/stdio.test.js",
    "test:http": "node --test --test-reporter spec test/http.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}
