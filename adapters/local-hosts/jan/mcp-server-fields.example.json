{
  "template_only": true,
  "name": "AutoCache Local Continuity",
  "transport": "STDIO",
  "command": "C:\\absolute\\path\\to\\node.exe",
  "args": [
    "C:\\absolute\\path\\to\\autocache\\adapters\\local-hosts\\mcp-server\\src\\cli.js",
    "stdio"
  ],
  "env": {
    "AUTOCACHE_HOME": "C:\\Users\\YOUR_USER\\.autocache",
    "AUTOCACHE_STORE_SCOPE": "jan",
    "AUTOCACHE_MCP_ACTOR": "jan",
    "AUTOCACHE_WORKSPACE": "C:\\absolute\\path\\to\\your\\workspace"
  }
}
